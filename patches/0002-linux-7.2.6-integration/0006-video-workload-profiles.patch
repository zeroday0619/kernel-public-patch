+++ b/tools/video/tests/benchmark.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: GPL-2.0-only
+set -euo pipefail
+
+directory=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
+benchmark=$directory/benchmark.sh
+temp=$(mktemp -d)
+trap 'rm -rf -- "$temp"' EXIT
+fail() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }
+
+cd -- "$temp"
+# The literal substitution detects accidental evaluation of command arguments.
+# shellcheck disable=SC2016
+bash "$benchmark" --output "$temp/success" --runs 2 -- \
+	bash -c 'printf "%s\n" "$PWD" "$@"' command 'argument with spaces' '*' '$(false)' '' >/dev/null
+# shellcheck disable=SC2016
+printf '%s\n' "$temp" 'argument with spaces' '*' '$(false)' '' > "$temp/expected"
+cmp "$temp/expected" "$temp/success/run-1.stdout" || fail 'Command arguments or working directory changed.'
+cmp "$temp/expected" "$temp/success/run-2.stdout" || fail 'Repeated command changed.'
+[[ $(wc -l < "$temp/success/results.tsv") == 3 ]] || fail 'Incorrect run count.'
+[[ -s $temp/success/summary.txt && -f $temp/success/state-after-2.txt ]] || fail 'Missing artifacts.'
+
+status=0
+bash "$benchmark" --output "$temp/failure" --runs 2 -- bash -c 'printf failure >&2; exit 7' >/dev/null 2>&1 || status=$?
+[[ $status == 7 ]] || fail 'Command failure status was lost.'
+[[ -f $temp/failure/run-1.stderr && ! -e $temp/failure/run-2.stdout && ! -e $temp/failure/summary.txt ]] || fail 'Failure did not abort with artifacts retained.'
+
+for value in 0 -1 1.5 01 abc 1000000; do
+	if bash "$benchmark" --output "$temp/invalid-$value" --runs "$value" -- true >/dev/null 2>&1; then
+		fail "Invalid run count accepted: $value"
+	fi
+	[[ ! -e $temp/invalid-$value ]] || fail 'Invalid arguments created artifacts.'
+done
+if bash "$benchmark" --output "$temp/success" -- true >/dev/null 2>&1; then
+	fail 'Existing output directory accepted.'
+fi
+cmp "$temp/expected" "$temp/success/run-1.stdout" || fail 'Existing artifacts changed.'
+bash "$benchmark" --output "$temp/default" -- true >/dev/null
+[[ $(wc -l < "$temp/default/results.tsv") == 6 ]] || fail 'Default is not five runs.'
+# The command must observe its original locale rather than the report locale.
+# shellcheck disable=SC2016
+LC_ALL=C.utf8 LANG=C bash "$benchmark" --output "$temp/locale-set" --runs 1 -- \
+	bash -c 'printf "%s\n" "${LC_ALL-unset}" "$LANG"' >/dev/null
+printf '%s\n' C.utf8 C > "$temp/locale-expected"
+cmp "$temp/locale-expected" "$temp/locale-set/run-1.stdout" || fail 'Explicit locale changed.'
+# shellcheck disable=SC2016
+env -u LC_ALL LANG=C.utf8 bash "$benchmark" --output "$temp/locale-unset" --runs 1 -- \
+	bash -c 'printf "%s\n" "${LC_ALL-unset}" "$LANG"' >/dev/null
+printf '%s\n' unset C.utf8 > "$temp/locale-expected"
+cmp "$temp/locale-expected" "$temp/locale-unset/run-1.stdout" || fail 'Unset locale changed.'
+printf 'PASS: benchmark command preservation, failures, validation, output protection, default runs, and locale preservation.\n'
