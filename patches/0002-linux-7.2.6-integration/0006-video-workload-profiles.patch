@@ -0,0 +1,161 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: GPL-2.0-only
+set -euo pipefail
+export LC_ALL=C
+# Inherited Kconfig redirections must not escape the selected output directory.
+unset KCONFIG_CONFIG KCONFIG_AUTOCONFIG KCONFIG_AUTOHEADER KCONFIG_RUSTCCFG
+unset KCONFIG_ALLCONFIG KCONFIG_OVERWRITECONFIG KCONFIG_DEFCONFIG_LIST
+
+log_failure() {
+    printf '%s failed; inspect %s.\n' "$1" "$2" >&2
+    exit 1
+}
+
+usage() {
+    cat <<'EOF'
+Usage: bash tools/video/configure.sh --base FILE --output DIRECTORY --profile interactive|throughput
+
+Generate and verify an isolated kernel configuration without building the kernel.
+The script can be invoked from any working directory.
+The explicit base may be a plain .config or gzip file such as /proc/config.gz.
+The output directory must be empty. Existing configurations are never replaced.
+LLVM defaults to -22; set LLVM=1 or another installed suffix/path as accepted by
+the kernel Makefile. The complete command, target version, base checksum, config
+diff, merge log and Kconfig log remain in the output directory.
+Existing DRM and media module choices are preserved. A profile suffix is added
+to the metadata revision or local version to distinguish the resulting kernels.
+The throughput default is lazy preemption. This x86 target does not support the
+voluntary runtime selection. No boot arguments or running settings are changed.
+EOF
+}
+
+base=''
+output=''
+profile=''
+while (($#)); do
+    case "$1" in
+        --base|--output|--profile)
+            (($# >= 2)) || { usage >&2; exit 2; }
+            case "$1" in
+                --base) base=$2 ;;
+                --output) output=$2 ;;
+                --profile) profile=$2 ;;
+            esac
+            shift 2 ;;
+        --help|-h) usage; exit 0 ;;
+        *) usage >&2; exit 2 ;;
+    esac
+done
+[[ -n "$base" && -n "$output" ]] || { usage >&2; exit 2; }
+case "$profile" in interactive|throughput) ;; *) usage >&2; exit 2 ;; esac
+source_directory=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)
+base=$(realpath -e -- "$base")
+output=$(realpath -m -- "$output")
+[[ "$output" != "$source_directory" ]] || { echo 'The source root cannot be the output directory.' >&2; exit 2; }
+[[ -r "$base" && -f "$base" ]] || { echo 'The base must be a readable regular file.' >&2; exit 2; }
+if [[ -e "$output" ]]; then
+    [[ -d "$output" && -z "$(find "$output" -mindepth 1 -maxdepth 1 -print -quit)" ]] || {
+        echo 'The output directory must be empty; existing files are preserved.' >&2
+        exit 2
+    }
+fi
+llvm=${LLVM:--22}
+case "$llvm" in
+    1) compiler=clang ;;
+    */) compiler="${llvm}clang" ;;
+    -*) compiler="clang${llvm}" ;;
+    *) echo 'LLVM must be 1, a version suffix, or a toolchain directory ending in /.' >&2; exit 2 ;;
+esac
+command -v "$compiler" >/dev/null || { echo "Compiler not found: $compiler" >&2; exit 2; }
+mkdir -p -- "$output"
+case "$base" in
+    *.gz) gzip -dc -- "$base" > "$output/base.config" ;;
+    *) cp -- "$base" "$output/base.config" ;;
+esac
+grep -q '^CONFIG_X86_64=y$' "$output/base.config" || {
+    echo 'This profile requires an x86-64 base configuration.' >&2; exit 2;
+}
+generated="$output/video-base-derived.config"
+for symbol in CONFIG_DRM CONFIG_MEDIA_SUPPORT; do
+    value=$(sed -n "s/^${symbol}=//p" "$output/base.config")
+    case "$value" in y|m) ;; *) value=y ;; esac
+    printf '%s=%s\n' "$symbol" "$value" >> "$generated"
+done
+if grep -Fxq 'CONFIG_ZERODAY0619_KERNEL_INFO=y' "$output/base.config"; then
+    revision=$(sed -n 's/^CONFIG_ZERODAY0619_KERNEL_REVISION="\([A-Za-z0-9._+~-]*\)"$/\1/p' "$output/base.config")
+    [[ -n "$revision" ]] || { echo 'Missing or invalid metadata revision in base.' >&2; exit 2; }
+    printf 'CONFIG_ZERODAY0619_KERNEL_REVISION="%s-video-%s"\n' "$revision" "$profile" >> "$generated"
+else
+    local_version_line=$(grep '^CONFIG_LOCALVERSION=' "$output/base.config" || true)
+    local_version=''
+    if [[ -n "$local_version_line" ]]; then
+        if [[ "$local_version_line" =~ ^CONFIG_LOCALVERSION=\"([A-Za-z0-9._+~-]*)\"$ ]]; then
+            local_version=${BASH_REMATCH[1]}
+        else
+            echo 'Invalid CONFIG_LOCALVERSION in base: expected one quoted string containing only A-Z, a-z, 0-9, dot, underscore, plus, tilde, or hyphen.' >&2
+            exit 2
+        fi
+    fi
+    printf '# CONFIG_ZERODAY0619_KERNEL_INFO is not set\nCONFIG_LOCALVERSION="%s-video-%s"\n' "$local_version" "$profile" >> "$generated"
+fi
+fragments=("$source_directory/kernel/configs/video-common.config" "$source_directory/kernel/configs/video-${profile}.config" "$generated")
+{
+    printf 'source=%s\nbase=%s\noutput=%s\nprofile=%s\nLLVM=%s\n' "$source_directory" "$base" "$output" "$profile" "$llvm"
+    sed -n '1,5p' "$source_directory/Makefile"
+    "$compiler" --version
+    sha256sum "$output/base.config" "${fragments[@]}"
+    printf 'command:'
+    printf ' %q' make -C "$source_directory" "O=$output" ARCH=x86 "LLVM=$llvm" KCONFIG_CONFIG=.config olddefconfig
+    printf '\n'
+} > "$output/provenance.txt"
+# KCONFIG_CONFIG is pinned because inherited values can redirect writes elsewhere.
+(
+    cd -- "$output" || exit 1
+    KCONFIG_CONFIG="$output/.config" bash "$source_directory/scripts/kconfig/merge_config.sh" -m -O "$output" "$output/base.config" "${fragments[@]}"
+) > "$output/merge.log" 2>&1 || log_failure 'Configuration merge' "$output/merge.log"
+make -C "$source_directory" "O=$output" ARCH=x86 "LLVM=$llvm" KCONFIG_CONFIG=.config olddefconfig > "$output/kconfig.log" 2>&1 || log_failure olddefconfig "$output/kconfig.log"
+for target in listnewconfig kernelrelease; do
+    {
+        printf 'command:'
+        printf ' %q' make -s --no-print-directory -C "$source_directory" "O=$output" ARCH=x86 "LLVM=$llvm" KCONFIG_CONFIG=.config "$target"
+        printf '\n'
+    } >> "$output/provenance.txt"
+done
+make -s --no-print-directory -C "$source_directory" "O=$output" ARCH=x86 "LLVM=$llvm" KCONFIG_CONFIG=.config listnewconfig > "$output/listnewconfig.log" 2>&1 || log_failure listnewconfig "$output/listnewconfig.log"
+if grep -q '^CONFIG_' "$output/listnewconfig.log"; then
+    echo 'Unresolved configuration options remain; inspect listnewconfig.log.' >&2
+    exit 1
+fi
+make -s --no-print-directory -C "$source_directory" "O=$output" ARCH=x86 "LLVM=$llvm" KCONFIG_CONFIG=.config kernelrelease > "$output/kernel.release" 2>> "$output/kconfig.log" || log_failure kernelrelease "$output/kconfig.log"
+release=$(cat "$output/kernel.release")
+if [[ -z "$release" || $(wc -l < "$output/kernel.release") -ne 1 || "$release" == *$'\n'* || ${#release} -gt 64 || "$release" == *[!\ -~]* ]]; then
+    echo 'The kernel release must be one nonempty ASCII line of at most 64 characters.' >&2
+    exit 1
+fi
+printf 'kernelrelease=%s\n' "$release" >> "$output/provenance.txt"
+declare -A requested=()
+for fragment in "${fragments[@]}"; do
+    while IFS= read -r line; do
+        if [[ "$line" =~ ^(CONFIG_[A-Za-z0-9_]+)=(.*)$ ]]; then
+            requested[${BASH_REMATCH[1]}]=${BASH_REMATCH[2]}
+        elif [[ "$line" =~ ^\#\ (CONFIG_[A-Za-z0-9_]+)\ is\ not\ set$ ]]; then
+            requested[${BASH_REMATCH[1]}]=n
+        fi
+    done < "$fragment"
+done
+failed=0
+for symbol in "${!requested[@]}"; do
+    value=${requested[$symbol]}
+    if [[ "$value" == n ]]; then
+        expected="# $symbol is not set"
+    else
+        expected="$symbol=$value"
+    fi
+    if ! grep -Fxq -- "$expected" "$output/.config"; then
+        printf 'Discarded or changed request: %s\n' "$expected" >&2
+        failed=1
+    fi
+done
+"$source_directory/scripts/diffconfig" "$output/base.config" "$output/.config" > "$output/config.diff"
+((failed == 0)) || exit 1
+printf 'Verified %s requested symbols.\nConfiguration: %s/.config\nDiff: %s/config.diff\n' "${#requested[@]}" "$output" "$output"
diff --git a/tools/video/run.sh b/tools/video/run.sh
new file mode 100755
index 0000000000000000000000000000000000000000..145025ef1fd9dce87a9430f0be39a9568d97c5d1
--- /dev/null
+++ b/tools/video/run.sh
@@ -0,0 +1,112 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: GPL-2.0
+set -euo pipefail
+
+fail() { printf 'video-profile: %s\n' "$*" >&2; exit 2; }
+usage() {
+	printf '%s\n' 'Usage: run.sh [--dry-run] [--io-weight INTEGER] [--memory-low SIZE] [--cpus LIST] PROFILE -- COMMAND [ARGS...]' \
+		'Profiles: interactive, throughput, background.' \
+		'INTEGER: optional I/O weight from 1 to 10000; requires delegated I/O control.' \
+		'SIZE: positive page-aligned integer bytes, or integer with K, M, G suffix (binary units).' \
+		'LIST: taskset process affinity; CPU numbers and ranges separated by commas (0-8191).' \
+		'Weights are relative candidate settings, not real-time scheduling guarantees.'
+}
+
+normalize_cpus() {
+	local part first last cpu
+	local -a parts
+	[[ $1 =~ ^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$ ]] || return 1
+	IFS=, read -r -a parts <<< "$1"
+	for part in "${parts[@]}"; do
+		first=${part%%-*}; last=${part##*-}
+		[[ ${#first} -le 4 && ${#last} -le 4 ]] || return 1
+		first=$((10#$first)); last=$((10#$last))
+		(( first <= last && last <= 8191 )) || return 1
+		for ((cpu=first; cpu<=last; cpu++)); do printf '%s\n' "$cpu"; done
+	done | sort -nu | paste -sd, -
+}
+
+# The verifier runs inside the scope so delegation failures cannot silently
+# launch a workload with different resource controls than those requested.
+if [[ ${1-} == --internal-verify ]]; then
+	[[ $# -ge 7 && $6 == -- ]] || fail 'Invalid internal invocation.'
+	weight=$2; memory=$3; cpus=$4; io_weight=$5; shift 6
+	[[ $weight =~ ^(25|100|200)$ ]] || fail 'Invalid internal weight.'
+	path=
+	while IFS=: read -r hierarchy controllers value; do
+		if [[ $hierarchy == 0 && -z $controllers ]]; then path=$value; break; fi
+	done < /proc/self/cgroup
+	[[ $path == /* && $path != *..* ]] || fail 'Cannot locate the unified cgroup.'
+	cgroup=/sys/fs/cgroup$path
+	[[ -r $cgroup/cpu.weight && $(< "$cgroup/cpu.weight") == "$weight" ]] || fail 'CPU weight was not applied.'
+	if [[ -n $io_weight ]]; then
+		[[ -r $cgroup/io.weight ]] || fail 'I/O weight controller is unavailable; delegate the io controller to the user manager before requesting --io-weight.'
+		read -r label actual < "$cgroup/io.weight"
+		[[ $label == default && $actual == "$io_weight" ]] || fail 'I/O weight was not applied.'
+	fi
+	if [[ -n $memory ]]; then
+		[[ -r $cgroup/memory.low && $(< "$cgroup/memory.low") == "$memory" ]] || fail 'Memory protection was not applied.'
+	fi
+	if [[ -n $cpus ]]; then
+		actual=
+		# Reading with shell builtins observes this process before it executes the workload.
+		while read -r label value; do
+			if [[ $label == Cpus_allowed_list: ]]; then actual=$value; break; fi
+		done < /proc/self/status
+		# Parent restrictions and offline CPUs can reduce the effective affinity.
+		actual=$(normalize_cpus "$actual") || fail 'Cannot read effective CPU affinity.'
+		[[ $actual == "$cpus" ]] || fail 'Effective CPU placement differs from the requested set.'
+	fi
+	printf 'video-profile: verified %s; cpu.weight=%s io.weight=%s memory.low=%s cpus=%s\n' \
+		"$path" "$weight" "${io_weight:-unchanged}" "${memory:-default}" "${cpus:-inherited}" >&2
+	exec "$@"
+fi
+
+dry_run=false; memory=; cpus=; io_weight=
+while [[ $# -gt 0 ]]; do
+	case $1 in
+	--dry-run) dry_run=true; shift ;;
+	--io-weight)
+		[[ $# -ge 2 && $2 =~ ^[0-9]{1,5}$ ]] || fail 'Invalid I/O weight.'
+		io_weight=$((10#$2))
+		(( io_weight >= 1 && io_weight <= 10000 )) || fail 'I/O weight must be between 1 and 10000.'
+		shift 2 ;;
+	--memory-low)
+		[[ $# -ge 2 && $2 =~ ^([0-9]{1,7})([KMG]?)$ ]] || fail 'Invalid memory size.'
+		amount=$((10#${BASH_REMATCH[1]})); suffix=${BASH_REMATCH[2]}
+		(( amount > 0 )) || fail 'Memory size must be positive.'
+		case $suffix in K) factor=1024 ;; M) factor=1048576 ;; G) factor=1073741824 ;; *) factor=1 ;; esac
+		memory=$((amount * factor))
+		page_size=$(getconf PAGESIZE) || fail 'Cannot determine the system page size.'
+		[[ $page_size =~ ^[0-9]+$ ]] || fail 'Invalid system page size.'
+		(( page_size > 0 )) || fail 'Invalid system page size.'
+		(( memory % page_size == 0 )) || fail "Memory size must be a multiple of the system page size ($page_size bytes)."
+		shift 2 ;;
+	--cpus)
+		[[ $# -ge 2 ]] || fail 'Missing CPU list.'
+		cpus=$(normalize_cpus "$2") || fail 'Invalid CPU list.'
+		[[ -n $cpus ]] || fail 'Empty CPU list.'
+		shift 2 ;;
+	-h|--help) usage; exit 0 ;;
+	-*) fail "Unknown option: $1" ;;
+	*) break ;;
+	esac
+done
+[[ $# -ge 3 && $2 == -- ]] || { usage >&2; exit 2; }
+case $1 in interactive) weight=200 ;; throughput) weight=100 ;; background) weight=25 ;; *) fail "Unknown profile: $1" ;; esac
+profile=$1; shift 2
+[[ -n $1 ]] || fail 'Empty command.'
+script_directory=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+command=(systemd-run --user --scope --collect --expand-environment=no --slice=app.slice
+	"--unit=video-${profile}-$$-${RANDOM}.scope"
+	"--property=CPUWeight=$weight")
+[[ -z $io_weight ]] || command+=("--property=IOWeight=$io_weight")
+[[ -z $memory ]] || command+=("--property=MemoryLow=$memory")
+command+=(--)
+[[ -z $cpus ]] || command+=(taskset --cpu-list "$cpus")
+command+=("$script_directory/run.sh" --internal-verify "$weight" "$memory" "$cpus" "$io_weight" -- "$@")
+if "$dry_run"; then printf '%q ' "${command[@]}"; printf '\n'; exit 0; fi
+[[ -r /sys/fs/cgroup/cgroup.controllers ]] || fail 'A unified cgroup v2 mount is required at /sys/fs/cgroup.'
+command -v systemd-run >/dev/null || fail 'systemd-run is required.'
+if [[ -n $cpus ]]; then command -v taskset >/dev/null || fail 'taskset is required for --cpus.'; fi
+exec "${command[@]}"
