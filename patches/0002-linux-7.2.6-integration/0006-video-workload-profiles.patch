+#!/usr/bin/env bash
+# SPDX-License-Identifier: GPL-2.0-only
+set -euo pipefail
+original_locale_set=${LC_ALL+x}
+original_locale=${LC_ALL-}
+export LC_ALL=C
+
+usage() {
+	printf 'Usage: %s --output NEW_DIRECTORY [--runs COUNT] -- COMMAND [ARGUMENT ...]\n' "$0"
+}
+
+output=
+runs=5
+while (($#)); do
+	case "$1" in
+	--output|--runs)
+		(($# >= 2)) || { usage >&2; exit 2; }
+		if [[ $1 == --output ]]; then output=$2; else runs=$2; fi
+		shift 2
+		;;
+	--) shift; break ;;
+	-h|--help) usage; exit 0 ;;
+	*) usage >&2; exit 2 ;;
+	esac
+done
+[[ -n $output && $# -gt 0 && $runs =~ ^[1-9][0-9]*$ && ${#runs} -le 6 ]] || {
+	usage >&2
+	exit 2
+}
+# Atomic directory creation prevents overwriting an earlier measurement.
+mkdir -- "$output" || exit 2
+output=$(cd -- "$output" && pwd -P)
+
+capture_state() {
+	local destination=$1 path
+	{
+		for path in /proc/pressure/cpu /proc/pressure/memory /proc/pressure/io \
+			/proc/sys/kernel/sched_bore /sys/kernel/mm/lru_gen/enabled \
+			/sys/kernel/debug/sched/preempt /sys/block/*/queue/scheduler; do
+			if [[ -r $path ]]; then
+				printf '\n[%s]\n' "$path"
+				cat -- "$path" || true
+			fi
+		done
+	} > "$destination"
+}
+
+{
+	date -u '+date_utc=%Y-%m-%dT%H:%M:%SZ'
+	uname -a
+	printf 'working_directory=%q\n' "$PWD"
+	printf 'runs=%s\ncommand=' "$runs"
+	printf '%q ' "$@"
+	printf '\n'
+	awk '/^model name[[:space:]]*:/ { print; exit }' /proc/cpuinfo
+} > "$output/environment.txt"
+capture_state "$output/state-before.txt"
+if command -v nvidia-smi >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
+	timeout 10s nvidia-smi --query-gpu=name,driver_version --format=csv \
+		> "$output/nvidia-smi.txt" 2>&1 || true
+fi
+printf 'run\telapsed_seconds\texit_status\n' > "$output/results.tsv"
+for ((run=1; run<=runs; run++)); do
+	status=0
+	# The inner redirections keep command output separate from Bash timing.
+	TIMEFORMAT=%R
+	{ time (
+		if [[ $original_locale_set == x ]]; then
+			export LC_ALL=$original_locale
+		else
+			unset LC_ALL
+		fi
+		exec "$@"
+	) > "$output/run-$run.stdout" 2> "$output/run-$run.stderr"; } \
+		2> "$output/run-$run.elapsed" || status=$?
+	printf '%s\t%s\t%s\n' "$run" "$(cat -- "$output/run-$run.elapsed")" "$status" >> "$output/results.tsv"
+	capture_state "$output/state-after-$run.txt"
+	if ((status != 0)); then
+		printf 'Run %s failed with status %s. Artifacts: %s\n' "$run" "$status" "$output" >&2
+		exit "$status"
+	fi
+done
+awk 'NR > 1 { print $2 }' "$output/results.tsv" | sort -n | awk '
+	{ elapsed[NR] = $1; total = NR }
+	END {
+		middle = int((total + 1) / 2)
+		median = total % 2 ? elapsed[middle] : (elapsed[middle] + elapsed[middle + 1]) / 2
+		printf "runs=%d\nmin_seconds=%.6f\nmedian_seconds=%.6f\nmax_seconds=%.6f\n", total, elapsed[1], median, elapsed[total]
+		print "Elapsed wall time only. Frame rate, frame latency, output quality, and correctness are not inferred."
+	}' > "$output/summary.txt"
+cat -- "$output/summary.txt"
+printf 'Artifacts: %s\n' "$output"
