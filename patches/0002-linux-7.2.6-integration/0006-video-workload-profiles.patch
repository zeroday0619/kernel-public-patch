+#!/usr/bin/env bash
+# SPDX-License-Identifier: GPL-2.0-only
+set -euo pipefail
+
+directory=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
+source_directory=$(cd -- "$directory/../.." && pwd -P)
+temp=$(mktemp -d)
+trap 'rm -rf -- "$temp"' EXIT
+printf 'CONFIG_X86_64=y\n' > "$temp/base.config"
+mkdir "$temp/existing"
+printf 'Original configuration.\n' > "$temp/existing/.config"
+cp "$temp/existing/.config" "$temp/expected"
+
+reject() {
+	local status=0
+	bash "$directory/configure.sh" "$@" > "$temp/output.log" 2>&1 || status=$?
+	if ((status == 0)); then
+		printf 'FAIL: Invalid configuration request was accepted.\n' >&2
+		exit 1
+	fi
+}
+
+reject --base "$temp/base.config" --output "$temp/existing" --profile interactive
+cmp "$temp/existing/.config" "$temp/expected"
+reject --base "$temp/base.config" --output "$source_directory" --profile interactive
+reject --base "$temp/base.config" --output "$temp/invalid" --profile invalid
+[[ ! -e $temp/invalid ]]
+reject --base "$temp/missing.config" --output "$temp/missing" --profile interactive
+[[ ! -e $temp/missing ]]
+reject --base "$temp/base.config" --output
+reject --unknown
+printf 'CONFIG_X86_64=y\nCONFIG_LOCALVERSION="-video@test"\n' > "$temp/invalid-localversion.config"
+reject --base "$temp/invalid-localversion.config" --output "$temp/invalid-localversion" --profile interactive
+grep -q 'Invalid CONFIG_LOCALVERSION' "$temp/output.log"
+[[ ! -e $temp/invalid-localversion/.config ]]
+[[ ! -e $temp/invalid-localversion/kconfig.log ]]
+printf 'CONFIG_X86_64=y\nCONFIG_LOCALVERSION=-unquoted\n' > "$temp/malformed-localversion.config"
+reject --base "$temp/malformed-localversion.config" --output "$temp/malformed-localversion" --profile interactive
+grep -q 'Invalid CONFIG_LOCALVERSION' "$temp/output.log"
+[[ ! -e $temp/malformed-localversion/.config ]]
+mkdir "$temp/bin"
+cat > "$temp/bin/make" <<'EOF'
+#!/usr/bin/env bash
+printf 'Injected configuration failure.\n' >&2
+exit 17
+EOF
+chmod +x "$temp/bin/make"
+PATH="$temp/bin:$PATH" reject --base "$temp/base.config" --output "$temp/make-failure" --profile interactive
+grep -Fq "olddefconfig failed; inspect $temp/make-failure/kconfig.log" "$temp/output.log"
+grep -q 'Injected configuration failure' "$temp/make-failure/kconfig.log"
+printf 'PASS: configuration output protection and invalid-input rejection.\n'
diff --git a/tools/video/tests/run-profile.sh b/tools/video/tests/run-profile.sh
new file mode 100755
index 0000000000000000000000000000000000000000..09e552418728d5384b6d8e7985726b4c83570d4b
--- /dev/null
+++ b/tools/video/tests/run-profile.sh
@@ -0,0 +1,95 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: GPL-2.0
+set -euo pipefail
+directory=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
+temp=$(mktemp -d)
+trap 'rm -rf -- "$temp"' EXIT
+export VIDEO_TEST_ARGUMENTS="$temp/arguments" VIDEO_TEST_STATUS=0
+cat > "$temp/systemd-run" <<'MOCK'
+#!/usr/bin/env bash
+printf '%s\0' "$@" > "$VIDEO_TEST_ARGUMENTS"
+exit "$VIDEO_TEST_STATUS"
+MOCK
+chmod +x "$temp/systemd-run"
+export PATH="$temp:$PATH"
+fail() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }
+contains() { local value; for value in "${arguments[@]}"; do [[ $value != "$1" ]] || return 0; done; return 1; }
+# Literal expansion syntax exercises argument preservation across the launcher.
+# shellcheck disable=SC2016
+hostile_argument='literal $HOME; $(touch invalid)'
+for entry in interactive:200 throughput:100 background:25; do
+	"$directory/run.sh" "${entry%:*}" -- printf '%s' "$hostile_argument"
+	mapfile -d '' -t arguments < "$VIDEO_TEST_ARGUMENTS"
+	contains "--property=CPUWeight=${entry#*:}" || fail 'CPU weight'
+	contains --slice=app.slice || fail 'Shared parent slice'
+	contains --expand-environment=no || fail 'Environment expansion disabled'
+	[[ ${arguments[-1]} == "$hostile_argument" ]] || fail 'Argument boundary'
+	for value in "${arguments[@]}"; do [[ $value != --property=MemoryLow=* ]] || fail 'Unexpected default memory protection'; done
+	for value in "${arguments[@]}"; do [[ $value != --property=IOWeight=* ]] || fail 'Unexpected default I/O weight'; done
+done
+"$directory/run.sh" --io-weight 200 --memory-low 2G --cpus 2-3,1,2 interactive -- printf '%s' '' '--leading-option'
+mapfile -d '' -t arguments < "$VIDEO_TEST_ARGUMENTS"
+contains --property=IOWeight=200 || fail 'Explicit I/O weight'
+contains --property=MemoryLow=2147483648 || fail 'Memory units'
+contains taskset || fail 'CPU affinity launcher'
+contains --cpu-list || fail 'CPU affinity option'
+contains 1,2,3 || fail 'CPU normalization'
+for value in "${arguments[@]}"; do [[ $value != --property=AllowedCPUs=* ]] || fail 'Unexpected cpuset restriction'; done
+[[ ${arguments[-2]} == '' && ${arguments[-1]} == --leading-option ]] || fail 'Empty argument preservation'
+# Exercising the installed launcher catches operand parsing differences that mocks cannot detect.
+if command -v taskset >/dev/null; then
+	current_cpus=
+	while read -r label value; do
+		if [[ $label == Cpus_allowed_list: ]]; then current_cpus=$value; break; fi
+	done < /proc/self/status
+	[[ -n $current_cpus ]] || fail 'Cannot read test process affinity'
+	selected_cpu=${current_cpus%%[-,]*}
+	"$directory/run.sh" --cpus "$selected_cpu" throughput -- true
+	mapfile -d '' -t affinity_arguments < "$VIDEO_TEST_ARGUMENTS"
+	launcher=()
+	for ((index=0; index<${#affinity_arguments[@]}; index++)); do
+		if [[ ${affinity_arguments[index]} == taskset ]]; then
+			launcher=("${affinity_arguments[@]:index:3}")
+			[[ ${affinity_arguments[index+3]} == "$directory/run.sh" ]] || fail 'Unexpected taskset executable operand'
+			break
+		fi
+	done
+	[[ ${#launcher[@]} == 3 ]] || fail 'Missing taskset invocation'
+	# The child shell evaluates its own status and positional parameter.
+	# shellcheck disable=SC2016
+	"${launcher[@]}" /bin/bash -c '
+		while read -r label value; do
+			if [[ $label == Cpus_allowed_list: ]]; then [[ $value == "$1" ]]; exit; fi
+		done < /proc/self/status
+		exit 1
+	' affinity-test "$selected_cpu" || fail 'Real taskset affinity read-back'
+fi
+page_size=$(getconf PAGESIZE)
+"$directory/run.sh" --memory-low "$page_size" throughput -- true
+mapfile -d '' -t arguments < "$VIDEO_TEST_ARGUMENTS"
+contains "--property=MemoryLow=$page_size" || fail 'Aligned byte size'
+rm -- "$VIDEO_TEST_ARGUMENTS"
+"$directory/run.sh" --dry-run interactive -- touch "$temp/must-not-exist" > "$temp/dry-run"
+[[ ! -e $VIDEO_TEST_ARGUMENTS && ! -e $temp/must-not-exist ]] || fail 'Dry run executed command'
+[[ -s $temp/dry-run ]] || fail 'Dry run missing command'
+for invalid in '' unknown '--unknown'; do
+	if "$directory/run.sh" "$invalid" -- true >/dev/null 2>&1; then fail 'Invalid profile accepted'; fi
+done
+for invalid in '' 0 -1 1 2GB '1;true' 99999999G; do
+	if "$directory/run.sh" --memory-low "$invalid" interactive -- true >/dev/null 2>&1; then fail 'Invalid memory accepted'; fi
+done
+for invalid in '' 0 -1 10001 '1;true'; do
+	if "$directory/run.sh" --io-weight "$invalid" interactive -- true >/dev/null 2>&1; then fail 'Invalid I/O weight accepted'; fi
+done
+if (( page_size > 1024 )); then
+	if "$directory/run.sh" --memory-low 1K interactive -- true >/dev/null 2>&1; then fail 'Unaligned memory accepted'; fi
+fi
+for invalid in '' -1 3-1 8192 '0;true' '1,,2' '0-9000'; do
