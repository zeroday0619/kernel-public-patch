+	@echo 'make lint      Run ShellCheck on the tools and tests.'
+	@echo 'Configuration targets compile Kconfig host utilities, not the kernel.'
+
+configure:
+	bash ./configure.sh --base "$$BASE" --output "$$OUTPUT" --profile "$$PROFILE"
+
+lint:
+	shellcheck configure.sh run.sh benchmark.sh tests/*.sh
+
+check: lint
+	@for script in configure.sh run.sh benchmark.sh tests/*.sh; do bash -n "$$script" || exit; done
+	bash tests/configure.sh
+	bash tests/run-profile.sh
