+	guard(spinlock_irqsave)(&pgdat->kcompress_fifo_lock);
+	if (kfifo_len(&pgdat->kcompress_fifo) >= limit * sizeof(folio))
+		return false;
+	folio_get(folio);
+	queued = kfifo_in(&pgdat->kcompress_fifo, &folio, sizeof(folio));
+	if (queued != sizeof(folio)) {
+		folio_put(folio);
+		return false;
+	}
+	wake_up(&pgdat->kcompressd_wait);
+	return true;
