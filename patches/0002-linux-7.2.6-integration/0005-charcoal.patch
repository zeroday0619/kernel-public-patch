+static bool kcompressd_store(struct folio *folio)
+{
+	pg_data_t *pgdat = folio_pgdat(folio);
+	unsigned int limit = READ_ONCE(vm_kcompressd);
+	unsigned int queued;
+	bool writeback_enabled;
