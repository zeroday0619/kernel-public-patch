+	if (!limit || current != READ_ONCE(pgdat->kswapd) ||
+	    !smp_load_acquire(&pgdat->kcompressd) || !folio_test_anon(folio))
+		return false;
+
+	rcu_read_lock();
+	writeback_enabled = mem_cgroup_zswap_writeback_enabled(folio_memcg(folio));
+	rcu_read_unlock();
