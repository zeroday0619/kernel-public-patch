+	/* Compression must make progress when reclaim exhausted normal reserves. */
+	current->flags |= PF_MEMALLOC | PF_KSWAPD;
+	complete(&pgdat->kcompressd_started);
+	for (;;) {
+		wait_event(pgdat->kcompressd_wait,
+			   kthread_should_stop() || !kfifo_is_empty(&pgdat->kcompress_fifo));
+		while (kfifo_out_locked(&pgdat->kcompress_fifo, &folio,
+				       sizeof(folio), &pgdat->kcompress_fifo_lock)) {
+			/* A changed cgroup policy must not permit forbidden writeback. */
+			if (swap_writeout_compressed(folio, NULL) == AOP_WRITEPAGE_ACTIVATE) {
+				folio_clear_reclaim(folio);
+				folio_unlock(folio);
+			}
+			folio_put(folio);
+			cond_resched();
+		}
+		/* The producer is stopped before shutdown, so the drained queue is final. */
+		if (kthread_should_stop())
