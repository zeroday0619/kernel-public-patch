Subject: [PATCH] feat(kernel): expose zeroday0619 kernel metadata

Expose structured identity and build metadata for the zeroday0619 high
performance kernel under /sys/kernel/zeroday0619. Include the product
name, complete release, base version, codename, deployment profile,
compiler family, revision, target architecture, and build UUID.

Build the release from structured Kconfig fields. Restrict deployment
profiles to workstation and server, detect the compiler family
automatically, and reject unsupported metadata characters.

Validation:
- Passed git diff --check.
- Checkpatch reported no source errors; MAINTAINERS review remains.
- SPDX validation was not run because the Python ply module is unavailable.
- Passed POSIX shell syntax validation for scripts/setlocalversion.
- Verified workstation and server release formatting.
- Kernel build and runtime validation were not performed at user request.

---
diff --git a/include/linux/buildid.h b/include/linux/buildid.h
index 7acc06b22fb7..943ddae36f03 100644
--- a/include/linux/buildid.h
+++ b/include/linux/buildid.h
@@ -14,7 +14,8 @@ int build_id_parse_file(struct file *file, unsigned char *build_id, __u32 *size)
 int build_id_parse_nofault(struct vm_area_struct *vma, unsigned char *build_id, __u32 *size);
 int build_id_parse_buf(const void *buf, unsigned char *build_id, u32 buf_size);
 
-#if IS_ENABLED(CONFIG_STACKTRACE_BUILD_ID) || IS_ENABLED(CONFIG_VMCORE_INFO)
+#if IS_ENABLED(CONFIG_STACKTRACE_BUILD_ID) || IS_ENABLED(CONFIG_VMCORE_INFO) || \
+	IS_ENABLED(CONFIG_ZERODAY0619_KERNEL_INFO)
 extern unsigned char vmlinux_build_id[BUILD_ID_SIZE_MAX];
 void init_vmlinux_build_id(void);
 #else
diff --git a/init/Kconfig b/init/Kconfig
index c682cb5b5879..bf345b747ec3 100644
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -311,6 +311,40 @@ config LOCALVERSION_AUTO
 
 	  which is done within the script "scripts/setlocalversion".)
 
+config ZERODAY0619_KERNEL_INFO
+	bool "Expose zeroday0619 kernel metadata through sysfs"
+	depends on SYSFS
+	default y
+	help
+	  Create /sys/kernel/zeroday0619 and expose immutable metadata for the
+	  running zeroday0619 high performance kernel. When enabled, the
+	  structured fields below define the custom kernel release suffix and
+	  replace the standard local version components.
+
+config ZERODAY0619_KERNEL_PROFILE
+	string "zeroday0619 kernel deployment profile"
+	depends on ZERODAY0619_KERNEL_INFO
+	default "workstation"
+	help
+	  Set the deployment profile included in the kernel release and exposed
+	  through sysfs. Supported values are "workstation" and "server".
+
+config ZERODAY0619_KERNEL_CODENAME
+	string "zeroday0619 kernel codename"
+	depends on ZERODAY0619_KERNEL_INFO
+	default "fxsenshi"
+	help
+	  Set the distribution-specific codename included in the kernel release
+	  and exposed through sysfs.
+
+config ZERODAY0619_KERNEL_REVISION
+	string "zeroday0619 kernel revision"
+	depends on ZERODAY0619_KERNEL_INFO
+	default "v1+"
+	help
+	  Set the distribution-specific revision included in the kernel release
+	  and exposed through sysfs.
+
 config BUILD_SALT
 	string "Build ID Salt"
 	default ""
diff --git a/kernel/Makefile b/kernel/Makefile
index 1e1a31673577..af25cc3e0623 100644
--- a/kernel/Makefile
+++ b/kernel/Makefile
@@ -14,6 +14,7 @@ obj-y     = fork.o exec_domain.o exec_state.o panic.o \
 
 obj-$(CONFIG_MULTIUSER) += groups.o
 obj-$(CONFIG_VHOST_TASK) += vhost_task.o
+obj-$(CONFIG_ZERODAY0619_KERNEL_INFO) += zeroday0619_kernel_info.o
 
 ifdef CONFIG_FUNCTION_TRACER
 # Do not trace internal ftrace files
diff --git a/lib/buildid.c b/lib/buildid.c
index c4b737640621..b47fa7d66565 100644
--- a/lib/buildid.c
+++ b/lib/buildid.c
@@ -390,7 +390,8 @@ int build_id_parse_buf(const void *buf, unsigned char *build_id, u32 buf_size)
 	return err;
 }
 
-#if IS_ENABLED(CONFIG_STACKTRACE_BUILD_ID) || IS_ENABLED(CONFIG_VMCORE_INFO)
+#if IS_ENABLED(CONFIG_STACKTRACE_BUILD_ID) || IS_ENABLED(CONFIG_VMCORE_INFO) || \
+	IS_ENABLED(CONFIG_ZERODAY0619_KERNEL_INFO)
 unsigned char vmlinux_build_id[BUILD_ID_SIZE_MAX] __ro_after_init;
 
 /**
diff --git a/scripts/setlocalversion b/scripts/setlocalversion
index 28169d7e143b..396f9a7d6ed4 100755
--- a/scripts/setlocalversion
+++ b/scripts/setlocalversion
@@ -191,6 +191,51 @@ if ! test -e include/config/auto.conf; then
 	exit 1
 fi
 
+if grep -q '^CONFIG_ZERODAY0619_KERNEL_INFO=y$' include/config/auto.conf; then
+	zeroday0619_kernel_info_codename=$(sed -n 's/^CONFIG_ZERODAY0619_KERNEL_CODENAME=//p' include/config/auto.conf)
+	zeroday0619_kernel_info_revision=$(sed -n 's/^CONFIG_ZERODAY0619_KERNEL_REVISION=//p' include/config/auto.conf)
+	zeroday0619_kernel_info_profile=$(sed -n 's/^CONFIG_ZERODAY0619_KERNEL_PROFILE=//p' include/config/auto.conf)
+
+	case "${zeroday0619_kernel_info_profile}" in
+	workstation|server)
+		;;
+	*)
+		echo "Error: CONFIG_ZERODAY0619_KERNEL_PROFILE must be workstation or server" >&2
+		exit 1
+		;;
+	esac
+
+	case "${zeroday0619_kernel_info_codename}" in
+	''|*[!A-Za-z0-9._+~-]*)
+		echo "Error: CONFIG_ZERODAY0619_KERNEL_CODENAME contains unsupported characters" >&2
+		exit 1
+		;;
+	esac
+
+	case "${zeroday0619_kernel_info_revision}" in
+	''|*[!A-Za-z0-9._+~-]*)
+		echo "Error: CONFIG_ZERODAY0619_KERNEL_REVISION contains unsupported characters" >&2
+		exit 1
+		;;
+	esac
+
+	if grep -q '^CONFIG_CC_IS_CLANG=y$' include/config/auto.conf; then
+		zeroday0619_kernel_info_build_type=llvm
+	elif grep -q '^CONFIG_CC_IS_GCC=y$' include/config/auto.conf; then
+		zeroday0619_kernel_info_build_type=gcc
+	else
+		echo "Error: unable to determine the kernel compiler family" >&2
+		exit 1
+	fi
+
+	printf '%s-%s-%s-%s-%s\n' "${KERNELVERSION}" \
+		"${zeroday0619_kernel_info_codename}" \
+		"${zeroday0619_kernel_info_profile}" \
+		"${zeroday0619_kernel_info_build_type}" \
+		"${zeroday0619_kernel_info_revision}"
+	exit 0
+fi
+
 # version string from CONFIG_LOCALVERSION
 config_localversion=$(sed -n 's/^CONFIG_LOCALVERSION=\(.*\)$/\1/p' include/config/auto.conf)
 
diff --git a/kernel/zeroday0619_kernel_info.c b/kernel/zeroday0619_kernel_info.c
new file mode 100644
index 000000000000..73a51348a75d
--- /dev/null
+++ b/kernel/zeroday0619_kernel_info.c
@@ -0,0 +1,162 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define pr_fmt(fmt) "zeroday0619_kernel_info: " fmt
+
+#include <generated/compile.h>
+#include <generated/uapi/linux/version.h>
+#include <generated/utsrelease.h>
+
+#include <linux/buildid.h>
+#include <linux/cache.h>
+#include <linux/init.h>
+#include <linux/kobject.h>
+#include <linux/string.h>
+#include <linux/sysfs.h>
+#include <linux/uuid.h>
+
+#if defined(CONFIG_CC_IS_CLANG)
+#define ZERODAY0619_KERNEL_INFO_BUILD_TYPE "llvm"
+#elif defined(CONFIG_CC_IS_GCC)
+#define ZERODAY0619_KERNEL_INFO_BUILD_TYPE "gcc"
+#else
+#error Unsupported compiler family for zeroday0619 kernel metadata
+#endif
+
+#define ZERODAY0619_KERNEL_INFO_PRODUCT_NAME \
+	"zeroday0619 high performance kernel"
+#define ZERODAY0619_KERNEL_INFO_PROFILE CONFIG_ZERODAY0619_KERNEL_PROFILE
+
+#define ZERODAY0619_KERNEL_INFO_ATTRIBUTE_RO(_name) \
+static struct kobj_attribute _name##_attribute = __ATTR_RO(_name)
+
+static uuid_t zeroday0619_kernel_info_build_uuid __ro_after_init;
+
+static ssize_t product_name_show(struct kobject *kobject,
+				 struct kobj_attribute *attribute, char *buffer)
+{
+	return sysfs_emit(buffer, "%s\n",
+			  ZERODAY0619_KERNEL_INFO_PRODUCT_NAME);
+}
+
+ZERODAY0619_KERNEL_INFO_ATTRIBUTE_RO(product_name);
+
+static ssize_t kernel_release_show(struct kobject *kobject,
+				   struct kobj_attribute *attribute, char *buffer)
+{
+	return sysfs_emit(buffer, "%s\n", UTS_RELEASE);
+}
+
+ZERODAY0619_KERNEL_INFO_ATTRIBUTE_RO(kernel_release);
+
+static ssize_t kernel_version_show(struct kobject *kobject,
+				   struct kobj_attribute *attribute, char *buffer)
+{
+	return sysfs_emit(buffer, "%u.%u.%u\n",
+			  (unsigned int)LINUX_VERSION_MAJOR,
+			  (unsigned int)LINUX_VERSION_PATCHLEVEL,
+			  (unsigned int)LINUX_VERSION_SUBLEVEL);
+}
+
+ZERODAY0619_KERNEL_INFO_ATTRIBUTE_RO(kernel_version);
+
+static ssize_t kernel_codename_show(struct kobject *kobject,
+				    struct kobj_attribute *attribute, char *buffer)
+{
+	return sysfs_emit(buffer, "%s\n", CONFIG_ZERODAY0619_KERNEL_CODENAME);
+}
+
+ZERODAY0619_KERNEL_INFO_ATTRIBUTE_RO(kernel_codename);
+
+static ssize_t kernel_profile_show(struct kobject *kobject,
+				   struct kobj_attribute *attribute, char *buffer)
+{
+	return sysfs_emit(buffer, "%s\n", ZERODAY0619_KERNEL_INFO_PROFILE);
+}
+
+ZERODAY0619_KERNEL_INFO_ATTRIBUTE_RO(kernel_profile);
+
+static ssize_t kernel_buildtype_show(struct kobject *kobject,
+				     struct kobj_attribute *attribute, char *buffer)
+{
+	return sysfs_emit(buffer, "%s\n", ZERODAY0619_KERNEL_INFO_BUILD_TYPE);
+}
+
+ZERODAY0619_KERNEL_INFO_ATTRIBUTE_RO(kernel_buildtype);
+
+static ssize_t kernel_revision_show(struct kobject *kobject,
+				    struct kobj_attribute *attribute, char *buffer)
+{
+	return sysfs_emit(buffer, "%s\n", CONFIG_ZERODAY0619_KERNEL_REVISION);
+}
+
+ZERODAY0619_KERNEL_INFO_ATTRIBUTE_RO(kernel_revision);
+
+static ssize_t system_architecture_show(struct kobject *kobject,
+					struct kobj_attribute *attribute,
+					char *buffer)
+{
+	return sysfs_emit(buffer, "%s\n", UTS_MACHINE);
+}
+
+ZERODAY0619_KERNEL_INFO_ATTRIBUTE_RO(system_architecture);
+
+static ssize_t build_uuid_show(struct kobject *kobject,
+			       struct kobj_attribute *attribute, char *buffer)
+{
+	return sysfs_emit(buffer, "%pUb\n",
+			  &zeroday0619_kernel_info_build_uuid);
+}
+
+static struct kobj_attribute build_uuid_attribute =
+	__ATTR_RO_MODE(build_uuid, 0400);
+
+static struct attribute *zeroday0619_kernel_info_attributes[] = {
+	&product_name_attribute.attr,
+	&kernel_release_attribute.attr,
+	&kernel_version_attribute.attr,
+	&kernel_codename_attribute.attr,
+	&kernel_profile_attribute.attr,
+	&kernel_buildtype_attribute.attr,
+	&kernel_revision_attribute.attr,
+	&system_architecture_attribute.attr,
+	&build_uuid_attribute.attr,
+	NULL,
+};
+
+static const struct attribute_group zeroday0619_kernel_info_attribute_group = {
+	.attrs = zeroday0619_kernel_info_attributes,
+};
+
+static int __init zeroday0619_kernel_info_init(void)
+{
+	struct kobject *zeroday0619_kernel_info_kobject;
+	int error;
+
+	if (!memchr_inv(vmlinux_build_id, 0, BUILD_ID_SIZE_MAX)) {
+		pr_err("vmlinux build ID is unavailable\n");
+		return -EINVAL;
+	}
+
+	memcpy(zeroday0619_kernel_info_build_uuid.b, vmlinux_build_id,
+	       UUID_SIZE);
+	zeroday0619_kernel_info_build_uuid.b[6] =
+		(zeroday0619_kernel_info_build_uuid.b[6] & 0x0f) | 0x80;
+	zeroday0619_kernel_info_build_uuid.b[8] =
+		(zeroday0619_kernel_info_build_uuid.b[8] & 0x3f) | 0x80;
+
+	zeroday0619_kernel_info_kobject =
+		kobject_create_and_add("zeroday0619", kernel_kobj);
+	if (!zeroday0619_kernel_info_kobject)
+		return -ENOMEM;
+
+	error = sysfs_create_group(zeroday0619_kernel_info_kobject,
+				   &zeroday0619_kernel_info_attribute_group);
+	if (error) {
+		kobject_put(zeroday0619_kernel_info_kobject);
+		pr_err("failed to create sysfs attributes: %d\n", error);
+		return error;
+	}
+
+	return 0;
+}
+late_initcall(zeroday0619_kernel_info_init);
